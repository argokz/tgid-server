# PostgreSQL/PostGIS
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=almatygid
FILES_DIR=./files

# База пользователей
USERS_DB_USER=postgres
USERS_DB_PASSWORD=change-me
USERS_DB_HOST=localhost
USERS_DB_PORT=5432
USERS_DB_NAME=usersdb

# Не включать до завершения RBAC, аудита и переноса всех зависимых таблиц.
TOPOLOGY_MUTATIONS_ENABLED=false

# Общий kill-switch для create/update/delete журналов и атрибутов.
MUTATIONS_ENABLED=false

# Auth / JWT (P0). Production: AUTH_DISABLED=false и DEV_LOGIN_ENABLED=false.
# По умолчанию auth отключён для обратной совместимости локальных стендов.
AUTH_DISABLED=true
DEV_LOGIN_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Список origin через запятую.
CORS_ALLOWED_ORIGINS=https://itwin.kz,http://localhost:3007
