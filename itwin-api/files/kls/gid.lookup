--"pipeSections","vozdushnikLists","vozdushnik","id","name",0,"SELECT TOP 2000000 tn1.id, CONCAT('Воздушник № ', tn1.id,' ( ',COALESCE(el1.name,'признак трубопровада не указан'),' ), ','диаметр: ',COALESCE(diametr, 'не указан'))  name,hps1.lineID FROM vozdushnik tn1 LEFT JOIN heatPipeSections hps1 ON hps1.lineID = tn1.lineID LEFT JOIN pipeSections ps1 ON ps1.id = hps1.pipeSectionID LEFT JOIN externalSignLine el1 ON el1.id = tn1.priznak_truboprovoda WHERE ps1.id = $id$"
--"pipeSections","drenazhnyy_kranLists","drenazhnyy_kran","id","name",0,"SELECT TOP 2000000 tn2.id, CONCAT('Дренажный кран № ', tn2.id,' ( ',COALESCE(el2.name,'признак трубопровада не указан'),' ), ','диаметр: ',COALESCE(diametr, 'не указан'))  name,hps2.lineID FROM drenazhnyy_kran tn2 LEFT JOIN heatPipeSections hps2 ON hps2.lineID = tn2.lineID LEFT JOIN pipeSections ps2 ON ps2.id = hps2.pipeSectionID LEFT JOIN externalSignLine el2 ON el2.id = tn2.priznak_truboprovoda WHERE ps2.id = $id$"
--"pipeSections","zapornaya_armaturaLists","zapornaya_armatura","id","name",0,"SELECT TOP 2000000 tn3.id, CONCAT('Запорная арматура № ', tn3.id,' ( ',COALESCE(el3.name,'признак трубопровада не указан'),' ), ','диаметр: ',COALESCE(diametr, 'не указан'))  name,hps3.lineID FROM zapornaya_armatura tn3 LEFT JOIN heatPipeSections hps3 ON hps3.lineID = tn3.lineID LEFT JOIN pipeSections ps3 ON ps3.id = hps3.pipeSectionID LEFT JOIN externalSignLine el3 ON el3.id = tn3.priznak_truboprovoda WHERE ps3.id = $id$"



