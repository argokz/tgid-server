--"bypass","nodeID","nodes","id","name",0,"SELECT TOP 2000000 n.id, concat(case when n0.id is not null then concat('(', ec0.name, ' ', n0.externalNodeName, ')', ' ') else ' ' end,ec.name, ' ', n.externalNodeName,case n.externalSignID when 2 then ' (П)' when 3 then ' (О)' else '' end) as name from nodes n join externalCodes ec on ec.id=n.externalCodeID left join nodes n0 on n0.id=n.internalNodeID and n0.removed=0 left join externalCodes ec0 on ec0.id=n0.externalCodeID where n.removed=0 order by name"


