"drenazhnyy_kran","id","objectsOnLines","id","name",1,"SELECT TOP 2000000 ol.id, ol.lineID as name FROM objectsOnLines ol LEFT JOIN typesObjectOnLines tl ON tl.id = ol.typesObjectOnLinesID LEFT JOIN vmTypesObjectOnLines vm ON ol.objectID = vm.id AND tl.tableName = vm.tableName LEFT JOIN linesobj l ON l.id = ol.lineID LEFT JOIN nodes n1 ON n1.id = l.nodeID1 LEFT JOIN nodes n2 ON n2.id = l.nodeID2 LEFT JOIN heatPipeSections hps on hps.lineID = l.id LEFT JOIN externalSignLine esl ON esl.id = ol.externalSignLineID where ol.objectID = 5"
