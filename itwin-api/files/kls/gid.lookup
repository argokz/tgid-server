"externalCodes","belongMagistral","externalCodes","id","name",1,"SELECT DISTINCT TOP 2000000 hs.id, CONCAT(COALESCE(hs.name, n.externalNodeName), ' ',  f.name) AS name FROM externalCodes hs JOIN nodes n ON n.externalCodeID=hs.id JOIN fragments f ON f.id=n.fileID WHERE n.removed=0 AND n.fileID in ($fragments$) ORDER BY name"
"externalCodes","heatSourceID","heatSources","id","name",1,"SELECT TOP 2000000 hs.id, CONCAT(COALESCE(hs.name, n.externalNodeName), ' ',  f.name) AS name FROM heatSources hs JOIN nodes n ON n.id=hs.nodeID JOIN fragments f ON f.id=n.fileID WHERE n.removed=0 AND n.fileID in ($fragments$) ORDER BY name"

"pipeSections","vozdushnikLists","vozdushnik","id","name",0,"SELECT TOP 2000000 tn.id, CONCAT('Запорная арматура № ', tn.id,' ( ',COALESCE(el.name,'признак трубопровада не указан'),' ), ','диаметр: ',COALESCE(diametr, 'не указан'))  name, hps.lineID FROM vozdushnik tn LEFT JOIN heatPipeSections hps ON hps.lineID = tn.lineID LEFT JOIN pipeSections pps ON pps.id = hps.pipeSectionID LEFT JOIN externalSignLine el ON el.id = tn.priznak_truboprovoda WHERE pps.id = $id$"

--- "pipeSections","vozdushnikLists","vozdushnik","id","name",0,"SELECT TOP 2000000 tn.id, CONCAT('Запорная арматура № ', tn.id,' ( ',COALESCE(el.name,'признак трубопровада не указан'),' ), ','диаметр: ',COALESCE(diametr, 'не указан'))  name, hps.lineID FROM vozdushnik tn LEFT JOIN heatPipeSections hps ON hps.lineID = tn.lineID LEFT JOIN pipeSections pps ON pps.id = hps.pipeSectionID LEFT JOIN externalSignLine el ON el.id = tn.priznak_truboprovoda"

