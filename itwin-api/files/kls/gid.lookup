--"uchastok_ms","nomer_uchastka","uchastki_ekspluatatsii","id","SELECT TOP 2000000 ue.id, CONCAT(re.naimenovanie_rayona_ekspluatatsii_istochnika_tepla , ' ', nomer_uchastka, ' ', IIF(ue.vid_seti=1, 'МС', 'РС'), ' ', nach.fio) AS nomer_uchastka FROM uchastki_ekspluatatsii ue LEFT JOIN rayon_ekspluatatsii re ON re.id=ue.rayon_ekspluatatsii LEFT JOIN nachalniki_uchastkov nach ON nach.id=ue.nachalnik_uchastka WHERE ue.vid_seti=1"
